{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "master-key-exercises.vercel.app" }
      ],
      "destination": "https://lucky-action-plan.vercel.app/:path*",
      "permanent": true
    }
  ],
  "routes": [
    { "src": "/exercises", "dest": "/exercises.html" },
    { "src": "/exercises-zh", "dest": "/exercises-zh.html" },
    { "src": "/goals", "dest": "/goals.html" },
    { "src": "/buddy", "dest": "/buddy.html" },
    { "src": "/welcome", "dest": "/welcome.html" },
    { "src": "/analytics", "dest": "/analytics.html" },
    { "src": "/career", "dest": "/career.html" },
    { "src": "/health", "dest": "/health.html" },
    { "src": "/finances", "dest": "/finances.html" },
    { "src": "/relationships", "dest": "/relationships.html" },
    { "src": "/launch", "dest": "/launch.html" }
  ]
}
